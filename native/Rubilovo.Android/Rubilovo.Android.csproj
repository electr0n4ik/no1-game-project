<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <RootNamespace>Rubilovo.Android</RootNamespace>
    <AssemblyName>Rubilovo.Android</AssemblyName>
    <ApplicationId>ru.no1game.rubilovo</ApplicationId>
    <ApplicationTitle>Рубилово</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Logic/**/*.cs" LinkBase="Logic" />
  </ItemGroup>

</Project>
